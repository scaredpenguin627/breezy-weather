CREATE TABLE forecast_wind_samples(
    location_formatted_id TEXT NOT NULL,
    date INTEGER NOT NULL,
    speed_cm_s INTEGER NOT NULL,
    direction REAL,
    PRIMARY KEY(location_formatted_id, date),
    FOREIGN KEY(location_formatted_id) REFERENCES weathers(location_formatted_id) ON DELETE CASCADE ON UPDATE CASCADE
);

getByLocation:
SELECT date, speed_cm_s, direction FROM forecast_wind_samples
WHERE location_formatted_id = :locationFormattedId
ORDER BY date;

insert:
INSERT INTO forecast_wind_samples(location_formatted_id, date, speed_cm_s, direction)
VALUES (:locationFormattedId, :date, :speedCmS, :direction);

deleteForLocation:
DELETE FROM forecast_wind_samples WHERE location_formatted_id = :locationFormattedId;
